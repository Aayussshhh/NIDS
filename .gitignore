# ─── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ok/
*.egg-info/
.pytest_cache/

# ─── IDE / editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
