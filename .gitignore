# ─── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ok/
*.egg-info/
.pytest_cache/

# ─── IDE / editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/package-lock.json

# ─── Models & artifacts ─────────────────────────────────────────
# These are generated by training and can be re-created; don't commit
artifacts/models/*.pt
artifacts/models/*.json
artifacts/models/*.joblib
artifacts/scalers/*.joblib
artifacts/encoders/*.joblib
artifacts/logs/*.log
artifacts/logs/*.json
artifacts/logs/*.log.*

# ─── Datasets (never commit - GB-sized and licensed) ────────────
datasets/

# ─── OS ─────────────────────────────────────────────────────────
*.log
*.tmp
